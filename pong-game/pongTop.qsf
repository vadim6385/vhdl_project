set_global_assignment -name VHDL_FILE "../pong-fpga-vga/paddle2_ctrl.vhd"
set_global_assignment -name VHDL_FILE "../pong-fpga-vga/pongTop.vhd"
set_global_assignment -name VHDL_FILE "../pong-fpga-vga/uart_receiver.vhd"
set_global_assignment -name VHDL_FILE "../pong-fpga-vga/vga_controller.vhd"
